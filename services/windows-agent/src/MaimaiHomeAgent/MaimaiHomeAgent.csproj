<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationManifest>MaimaiHomeAgent.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MaimaiHomeAgent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.16" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="H.NotifyIcon" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\tray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\GameScreenshot.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="WarnIfPcWebMissing" BeforeTargets="BeforeBuild">
    <Warning
      Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')"
      Text="PC Web bundle not found at $(MSBuildProjectDirectory)\wwwroot\index.html. Run 'pnpm --dir apps/pc-web build' from the repo root before publishing. The Agent will still build, but '/' and SPA routes will return 404 until the bundle is generated." />
  </Target>


</Project>
