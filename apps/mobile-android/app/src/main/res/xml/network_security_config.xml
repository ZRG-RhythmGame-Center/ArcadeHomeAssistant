<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration

    This app is a LAN-only client that talks to a Windows agent over plain
    HTTP (and ws://) on RFC1918 addresses. Android Network Security Config
    does NOT support CIDR or IP-range entries inside <domain>; per-IP
    domain entries would silently fail to match arbitrary LAN addresses.

    The simplest valid policy for this use case is a base-config that
    permits cleartext globally. The android:usesCleartextTraffic="true"
    attribute on <application> already opens cleartext for everything;
    this NSC just confirms the policy explicitly and provides the system
    trust anchors for any future https:// traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
