<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration
    Whitelists RFC1918 private address ranges for cleartext HTTP.
    This allows the app to communicate with LAN agents on Android 9+ (API 28+)
    without requiring HTTPS for local network traffic.

    RFC1918 ranges covered:
      - 192.168.0.0/16  (most home/office routers)
      - 10.0.0.0/8      (corporate / VPN)
      - 172.16.0.0/12   (Docker, some enterprise)
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 192.168.0.0/16 -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <!-- 10.0.0.0/8 -->
        <domain includeSubdomains="true">10.0.0.0</domain>
        <!-- 172.16.0.0/12 -->
        <domain includeSubdomains="true">172.16.0.0</domain>
    </domain-config>
</network-security-config>
